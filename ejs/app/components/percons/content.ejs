<div class="card d-flex flex-column w-100 bg-card">
    <div class="wrapper-img d-flex flex-column position-relative w-100 ">
        <img src="<%- getMedia(lang, 'teams/percon1.jpg', 'images'); %>" class="w-100">
        <div class="cover w-100 h-100 position-absolute top-0 right-0 align-items-center d-flex justify-content-center transition-300">
            <div class="wrapper-icons d-flex gap-2 w-100 justify-content-center">
                <i class="fa-brands fa-facebook-f bg-secondary rounded-circle d-flex align-items-center justify-content-center fs-normal transition-300"></i>
                <i class="fa-brands fa-twitter bg-secondary rounded-circle d-flex align-items-center justify-content-center fs-normal transition-300"></i>
                <i class="fa-brands fa-facebook-f bg-secondary rounded-circle d-flex align-items-center justify-content-center fs-normal transition-300"></i>
                <i class="fa-brands fa-instagram bg-secondary rounded-circle d-flex align-items-center justify-content-center fs-normal transition-300"></i>
            </div>
        </div>
    </div>
    <div class="d-flex flex-column px-3 py-3 gap-2">
        <h3 class="fs-mid-title"><%- t.components.teamCard.name %></h3>
        <p><%- t.components.teamCard.job %></p>
    </div>
</div>