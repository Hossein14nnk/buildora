<div class="news-box shadow bg-white transition-300">
    <div class="image p-3">
        <span class="fs-normal bg-primary rounded-1 p-2 text-button-text"> <%- t.pages.ourBlog.category1 %></span>
    </div>
    <a href="#" class="d-flex gap-3 p-3 flex-column">
        <div class="d-flex align-items-center gap-2 fs-normal">
            <i class="fa-solid fa-calendar text-text"></i>
            <span class="text-text fs-normal"> <%- t.pages.ourBlog.date1 %></span>
        </div>
        <h3 class="fs-title fw-bold text-title-text mb-0"><%- t.pages.ourBlog.title1 %></h3>
        <p class="fs-big text-text lh-lg mb-0"><%- t.pages.ourBlog.description %></p>
        <div href="#" class="fs-title fw-bold text-decoration-none d-flex gap-2 align-items-center btn-hover primary-hover">
            <span class="fs-big fw-semibold text-button-text transition"><%- t.pages.ourBlog.txtButton %></span>
            <i class="fa-regular fa-arrow-right fs-normal"></i>
        </div>
    </a>
</div>