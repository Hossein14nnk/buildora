<!DOCTYPE html>
<html dir="<%= t.direction %>" lang="<%= lang %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageName %></title>
    <link rel="icon" type="image/png" href="<%= getMedia(lang, 'logo.webp', 'images') %>">
    <base href="<%= basePathPages() %>">
    <link rel="stylesheet" href="./assets/icons/fontawesome-free-7.3.1-web/css/all.min.css">
    <link rel="stylesheet" href="./assets/css/miz.min.css">
    <link rel="stylesheet" href="./assets/css/style.min.css">
</head>
<%_ 

let fontName = "";
switch(lang){
    case "en":
        fontName = "roboto";
    break;
    case "fa":
        fontName = "vazirmatn";
    break;
    default:
        fontName = "primary";
    break;
}

-%>
<body class="font-<%= fontName %>">