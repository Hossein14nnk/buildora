<!-- start approach -->
<div class="approach d-flex flex-column gap-3 bg-secondary-color px-6 py-6 radius-all-md gap-6">
    <!-- start title -->
    <h3 class="font-weight-bold on-secondary-color"><%= t.components.composites.approach.cardName %></h3>
    <!-- end title -->
    <!-- start horizontal-divider -->
    <hr class="horizontal-divider">
    <!-- end horizontal-divider -->
    <div class="d-flex flex-column">
        <div class="d-flex gap-5">
            <div class="d-flex align-items-baseline">
                <div class="d-flex align-items-center flex-column">
                    <div class="justify-content-center align-items-center d-flex p-1 radius-all-full border-style-solid bw-2 border-primary-color">
                        <i class="fa-solid fa-user p-4 overflow-hidden aspect-ratio-1x1 icon-size-sm secondary-color bg-on-secondary-color radius-all-full justify-content-center align-items-center d-flex"></i>
                    </div>
                    <div class="vertical-dot-line br-style-dashed border-primary-color bw-2" ></div>
                </div>
                <div class="d-flex align-items-end">
                    <div class="horizontal-dot-line bb-style-dashed border-primary-color bw-2"></div>
                    <div class="d-flex flex-column align-items-center">
                        <!-- start title -->
                        <span class="on-secondary-color"><%= t.components.composites.approach.number1 %></span>
                        <!-- end title -->
                        <!-- start horizontal-divider -->
                        <hr class="horizontal-divider">
                        <!-- end horizontal-divider -->
                    </div>
                </div>
                <div class="d-flex flex-column mis-4 gap-2">
                    <!-- start title -->
                    <h4 class="on-secondary-color"><%= t.components.composites.approach.title1 %></h4>
                    <!-- end title -->
                    <!-- start description -->
                    <p class="description"><%= t.components.composites.approach.description1 %></p>
                    <!-- end description -->
                </div>
            </div>
        </div>
    </div>
</div>
<!-- end approach -->