<!-- start services-card -->
<div class="brief-news d-flex align-items-center gap-4 p-2">
    <!-- start image-box -->
    <div class="image-box">
        <img src="<%= getMedia(lang, 'demo1/building1.png', 'images') %>" alt="<%= t.components.composites.briefNews.alt %>">
    </div>
    <!-- end image-box -->

    <div class="d-flex flex-column gap-2">
        <!-- start title -->
        <h6 class="txt-transform-uppercase font-weight-bold"><%= t.components.composites.briefNews.title %></h6>
        <!-- end title -->
        <div class="d-flex gap-1 font-weight-bold">
            <i class="fa-light fa-calendar icon-size-sm primary-color"></i>
            <!-- start description -->
            <p class="description txt-transform-uppercase txt-align-justify"><%= t.components.composites.briefNews.date %></p>
            <!-- end description -->
        </div>
    </div>
</div>
<!-- end services-card -->