<!-- ================== BRIEF-NEWS ================== -->

<div class="brief-news div flex-row align-items-center gap-4 p-2">

    <div class="image-box">
        <img src="<%= image %>" alt="<%= t.components.composites.briefNews.alt %>">
    </div>


    <div class="d-flex flex-column gap-2">

        <h6 class="txt-transform-uppercase font-weight-bold"><%= t.components.composites.briefNews.title %></h6>

        <div class="d-flex gap-1 font-weight-bold align-items-center">
            <i class="fa-light fa-calendar primary-color common-icon "></i>

            <span class="description txt-transform-uppercase txt-align-justify"><%= t.components.composites.briefNews.date %></span>

        </div>
    </div>
</div>
<!-- ================== END BRIEF-NEWS ================== -->
