<!-- start logo-stracture -->

    <div class="logo-stracture align-items-center d-flex gap-3">
        <div class="image-box">
            <img src="<%= getMedia(lang, 'logo.webp', 'images') %>" alt="<%= t.components.composities.logoStracture.logoAlt %>">
        </div>

        <div class="d-flex flex-column txt-align-justify">
            <h2 class="secondary-title txt-transform-uppercase"><%= t.components.composities.logoStracture.siteName %></h2>
            <p class="description-secondary txt-transform-uppercase txt-align-justify"><%= t.components.composities.logoStracture.subtitle %></p>
        </div>
    </div>
    

<!-- end logo-stracture -->