<!-- ================== APPROACH-ITEM ================== -->

    <div class="approach-item d-flex flex-column bg-secondary-color">
        <div class="d-flex gap-5">
            <div class="d-flex align-items-baseline">
                <div class="d-flex align-items-center flex-column">
                    <div class="justify-content-center align-items-center d-flex p-1 radius-all-full border-style-solid common-bw border-primary-color ">
                        <i class="fa-solid fa-user p-4 overflow-hidden aspect-ratio-1x1 icon-size-sm secondary-color bg-on-secondary-color radius-all-full justify-content-center align-items-center d-flex aspect-ratio-1x1 icon-size"></i>
                    </div>
                    <div class="vertical-dot-line br-style-dashed border-primary-color common-bw" ></div>
                </div>

                <div class="d-flex align-items-end">
                    <div class="horizontal-dot-line bb-style-dashed border-primary-color common-bw"></div>
                    <div class="d-flex flex-column align-items-center">

                        <span class="on-secondary-color"><%= t.components.composites.approachItem.number1 %></span>

                        <hr class="horizontal-divider">

                    </div>
                </div>
                <div class="d-flex flex-column mis-4 gap-2">

                    <h4 class="on-secondary-color"><%= t.components.composites.approachItem.title1 %></h4>


                    <p class="description"><%= t.components.composites.approachItem.description1 %></p>

                </div>
            </div>
        </div>
    </div>



<!-- ================== END APPROACH-ITEM ================== -->