<div class="section-card div flex-row align-items-center justify-content-space-between on-primary-color bg-secondary-color py-6 px-8 gap-6 common-radius w-100 flex-column flex-md-row">
    <div class="d-flex align-items-center gap-5">
        <i class="fa-solid fa-user primary-color common-icon"></i>
        <div class="d-flex flex-column gap-2">
            <span class="eyebrow"><%= upTitle %></span>
            <h4 class="on-secondary-color font-weight-bold"><%= title %></h4>
            <p class="text-color"><%= text %></p>
        </div>
    </div>
    <div class="d-flex align-items-center justify-content-center">
        <a href="<%= link %>" class="btn btn-primary">
            <span><%= btnText %></span>
            <i class="fa-solid fa-arrow-right text-dark"></i>
        </a>
    </div>
</div>