
<div class="our-service bg-card-color radius-all-lg p-8 d-flex flex-column gap-6 position-relative">

	<div class="d-flex flex-column gap-3">
		<h3 class="txt-size-title-sm font-weight-bold title-text-color"><%= title %></h3>
		<div class="horizontal-divider"></div>
	</div>

	<div class="d-flex flex-column"> 
		<%_ for (let i = 0; i < items.length; i++) { let item = items[i]; let isLast = i === items.length - 1; -%>

		<a
			href="<%= item.link %>"
			class="our-service-item d-flex align-items-center justify-content-space-between gap-6 p-4 txt-decoration-none cursor-pointer<%- item.active ? ' our-service__item--active bg-primary-light-color radius-all-md' : '' %><%- (!item.active && !isLast) ? ' bb-style-solid bw-1 border-fields-color' : '' %>"
		>
			<span class="txt-size-body font-weight-medium title-text-color"><%= item.title %></span>
			<i class="fa-solid fa-arrow-right-long on-primary-color"></i> 
		</a>

		<%_ } -%>
	</div>

</div>
