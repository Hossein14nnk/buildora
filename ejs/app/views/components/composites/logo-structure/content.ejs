<!-- ================== LOGO STRACTURE ================== -->

    <div class="logo-stracture div p-2">
        <a href="<%= navigation(lang, 'ar-project') >" class="d-flex align-items-center gap-2">
            <div class="image-box">
                <img src="<%= getMedia(lang, 'logo.webp', 'images') %>" alt="<%= t.components.composites.logoStructure.logoAlt %>">
            </div>

            <div class="d-flex flex-column txt-align-justify gap-1">
                <h5 class="on-secondary-color txt-transform-uppercase font-weight-bold"><%= t.components.composites.logoStructure.siteName %></h6>
                <span class="on-secondary-color txt-transform-uppercase txt-align-justify"><%= t.components.composites.logoStructure.subtitle %></span>
            </div>
        </a>
    </div>
    
<!-- ================== END LOGO STRACTURE ================== -->
