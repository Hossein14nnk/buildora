<!-- start logo-stracture -->

    <div class="logo-stracture align-items-center d-flex gap-3 p-1">
        <div class="image-box">
            <img src="<%= getMedia(lang, 'logo.webp', 'images') %>" alt="<%= t.components.composites.logoStructure.logoAlt %>">
        </div>

        <div class="d-flex flex-column txt-align-justify gap-1">
            <h6 class="on-secondary-color txt-transform-uppercase font-weight-bold"><%= t.components.composites.logoStructure.siteName %></h6>
            <p class="description-secondary txt-transform-uppercase txt-align-justify"><%= t.components.composites.logoStructure.subtitle %></p>
        </div>
    </div>
    

<!-- end logo-stracture -->