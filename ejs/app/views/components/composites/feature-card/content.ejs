        <img src="<%= image %>" alt="<%= alt %>">
    </div>
    <div class="d-flex flex-column gap-2">
        <h5 class="txt-transform-capitalize font-weight-semi-bold"><%= title %></h5>    
        <p class="description txt-transform-capitalize"><%= text %></p>
    </div>
</div>