<!-- start services-card -->

    <div class="brief-news d-flex align-items-center gap-4 p-1">
        <div class="image-box">
            <img src="<%= getMedia(lang, 'demo1/building1.png', 'images') %>" alt="<%= t.components.composities.briefNews.alt %>">
        </div>

        <div class="d-flex flex-column txt-align-justify">
            <h2 class="title txt-transform-uppercase"><%= t.components.composities.briefNews.title %></h2>
            <div class="d-flex gap-1">
                <i class="fa-light fa-calendar primary-color"></i>      
                <p class="description txt-transform-uppercase txt-align-justify"><%= t.components.composities.briefNews.date %></p>
            </div>
        </div>
    </div>
    

<!-- end services-card -->