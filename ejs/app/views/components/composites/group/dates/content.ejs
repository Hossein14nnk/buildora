<div class="group-dates div">
    <div class="next-service d-flex gap-1 pie-3 align-items-center common-bw border-divider-color bie-style-solid">
        <i class="fa-regular fa-calendar text-color common-icon"></i>
        <span class="text-color txt-align-justify"><%= date %></span>
    </div>
    <div class="next-service d-flex gap-1 px-3 align-items-center common-bw border-divider-color bie-style-solid">
        <i class="fa-regular fa-user text-color common-icon"></i>
        <span class="text-color txt-align-justify">by <%= author %></span>
    </div>
    <div class="next-service d-flex gap-1 px-3 align-items-center">
        <i class="fa-regular fa-comments text-color common-icon"></i>
        <span class="text-color txt-align-justify"><%= commentCount %> comments</span>
    </div>
</div>