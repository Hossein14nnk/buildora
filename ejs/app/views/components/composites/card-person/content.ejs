<div class="card-person div">
    <img class="common-radius aspect-ratio-4x3 object-cover radius-br-none radius-bl-none" src="<%= image %>" alt="<%= alt %>">
    <div class="px-4 d-flex flex-column gap-2">
        <h5 class="font-weight-semi-bold"><%= title %></h5>
        <p class="description"><%= description %></p>
        <div class="d-flex align-items-center gap-2">
            <i class="icon-box fa-brands fa-facebook"></i>
            <i class="icon-box fa-brands fa-instagram"></i>
            <i class="icon-box fa-brands fa-linkedin"></i>
        </div>
        <hr class="horizontal-divider">
    </div>
</div>