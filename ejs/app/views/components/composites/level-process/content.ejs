<div class="level-process div gap-4 w-100 align-items-center py-2">
    <i <%= icon %>  class="secondary-color bg-on-secondary-color radius-all-full p-4 w-fit-content aspect-ratio-1x1 d-flex align-items-center justify-content-center"></i>
    <div class="line-box d-flex align-items-center w-100">
        <div class="little-line bg-primary-color w-100"></div>
        <div class="circle bg-primary-color p-2 radius-all-full"></div>
        <div class="long-line bg-primary-color w-100"></div>
    </div>
    <div class="d-flex flex-column gap-3 align-items-center px-1">
        <span class="txt-size-title-sm"><%= number %></span>
        <h6 class="font-weight-bold txt-align-center" ><%= title %></h6>
        <p class="txt-align-center "><%= text %></p>
    </div>
</div>