<!-- start search -->

<form class="search">
    <input
        class="search-input"
        type="search"
        placeholder="<%= placeholder %>"
        aria-label="<%= placeholder %>"
    >

    <button
        class="search-button"
        type="submit"
        aria-label="Search"
    >
        <i class="fa-solid fa-magnifying-glass"></i>
    </button>
</form>

<!-- end search -->