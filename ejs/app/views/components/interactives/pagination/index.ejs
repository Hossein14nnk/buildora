<%- include('../../../layouts/component/head.ejs', {pageName: "pagination"}); -%>

<div class="bg-on-primary-color w-100 h-100 d-flex flex-column align-items-center justify-content-center gap-4">

    <!-- Example cards container -->
    <div id="products" class="products-grid">

        <% for (let i = 1; i <= 20; i++) { %>
            <div class="product-card">
                Card <%= i %>
            </div>
        <% } %>

    </div>

    <%- include('./content.ejs', {
        container: "#products",
        itemsPerPage: 6
    }); -%>

</div>

<%- include('../../../layouts/component/foot.ejs'); -%>