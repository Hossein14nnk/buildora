<!-- start tab -->

<div class="tab">

    <div class="tab-list" role="tablist">

        <% for (let [index, item] of items.entries()) { %>

            <button class="tab-item <%= index === 0 ? 'active' : '' %>" type="button" role="tab"
                data-tab="<%= item.value %>" aria-selected="<%= index === 0 ? 'true' : 'false' %>">
                <%= item.title %>
            </button>

            <% } %>

    </div>

    <div class="tab-content">

        <div class="tab-panel active" data-tab-content="all">
            <h3>All Content</h3>
            <p>
                Lorem ipsum dolor sit amet consectetur, adipisicing elit. Quod amet mollitia, dolorum reiciendis ipsam ipsa optio officia tempora dolore quo laudantium adipisci cumque, ab consequatur, vero eligendi animi natus veritatis.
            </p>
        </div>

        <div class="tab-panel" data-tab-content="residential">
            <h3>Residential Content</h3>

            <div class="card">
                Residential Content
            </div>
        </div>

        <div class="tab-panel" data-tab-content="commercial">
            <h3>Commercial Content</h3>
        </div>

        <div class="tab-panel" data-tab-content="industrial">
            <h3>Industrial Content</h3>
        </div>

        <div class="tab-panel" data-tab-content="interior">
            <h3>Interior Content</h3>
        </div>

    </div>

</div>

<!-- end tab -->