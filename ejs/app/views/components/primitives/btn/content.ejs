<!-- start btn -->
<!-- basic -->
<a href="<%= link %>" class="btn">
    <span><%= title %></span>
</a>

<!-- primary -->
<a href="<%= link %>" class="btn btn-primary">
    <span><%= title %></span>
    <i class="fa-solid fa-arrow-right text-dark"></i>
</a>

<!-- secondary -->
<a href="<%= link %>" class="btn btn-secondary">
    <span><%= title %></span>
</a>

<!-- tertiary -->
<a href="<%= link %>" class="btn btn-tertiary">
    <span><%= title %></span>
    <i class="fa-solid fa-arrow-right primary-color text-dark"></i>
</a>
<!-- end btn -->