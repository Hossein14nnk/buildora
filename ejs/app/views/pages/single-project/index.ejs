<%- include("../../layouts/page/head.ejs", { pageName: "single-project" }); %>

<main>
    <section id="hero" class="section bg-secondary-color">
        <div class="container">
            <%- include("../../components/composites/section-topic/content.ejs", {
                // link1: navigation(lang, "home-one"),
                // link2: navigation(lang, "ar-weblog"),
                // upTitle: t.pages.singleProject.hero.components.upTitle,
                // firstPartTitle: t.pages.singleProject.hero.components.heroTitle.title,
                // secondPartTitle: `<br>${t.pages.singleProject.hero.components.heroTitle.highlight}`,
                // text: t.pages.singleProject.hero.components.description

                link1: "ads",
                part1: "ads",
                link2: "ads",
                part2: "ads",
                part3: "ads",
                upTitle: "ads",
                firstPartTitle: "ads",
                secondPartTitle: "ads",
                text: "ads",
            }); %>
        </div>
    </section>
    <section id="content" class="section bg-color">
        <div class="container flex-column flex-xxl-row gap-4">
            <div class="block align-items-start gap-4 w-xxl-70">
                <img class="common-radius w-100" src="<%= getMedia(lang, "st-blog/thum4.jpg", "images"); %>" alt="single-weblog">
                <h5 class="font-weight-bold">About The Project</h5>
                <p class="description"><%= t.pages.singleProject.content.aboutProject %></p>
                <h5 class="font-weight-bold">Key Features</h5>

                <div class="d-grid grid-2 gap-4">
                    <% for (let i = 0; i < 6; i++) { %>
                        <div>
                            <%- include("../../components/composites/feature-card/content.ejs",{
                                image: getMedia(lang, 'demo1/vector1.png', 'images'),
                                alt: t.components.composites.servicesCard.alt,
                                title: t.components.composites.servicesCard.title,
                                text: t.components.composites.servicesCard.description
                            }); -%>
                        </div>
                     <% } %>
                </div> 
                <hr class="w-100 border-divider-color bw-1 border-style-solid">
            
                <h5 class="font-weight-bold">Project gallery</h5>
        
                <div class="d-grid grid-3 gap-4">
                    <% for (let i = 0; i < 6; i++) { %>
                        <div>
                            <img class="common-radius w-100" src="<%= getMedia(lang, "st-blog/thum4.jpg", "images"); %>" alt="single-weblog">
                        </div>
                     <% } %>
                </div> 
 
                
            </div>
            <aside class="block grow-1 common-radius gap-8">

                <div class="px-4 py-4 elevation-md bg-white-color rounded-2 radius-all-md">
                    <h4 class="font-weight-bold mb-3"><%= "project overview" %></h4>
                    <div class="horizontal-divider mb-3"></div>
                    <ul class="list-unstyled d-flex flex-column m-0 px-3">
                        <li class="categories-item justify-content-between">
                            <div class="d-flex flex-row align-items-center bg-card-color common-radius p-4 gap-8">
                                <i class="fa-solid fa-user primary-color icon-size-xxl"></i>
                                <div class="d-flex flex-column align-items-start">
                                    <h4>asdfaf</h4>
                                    <p class="ellipsis-1">Lorem ipsum dolor sit amet consectetur adipisicing elit. Itaque explicabo quis ipsum?</p>
                                </div>
                            </div> 
                        </li>
                    </ul> 
                </div>
                <%- include("../../components/composites/call-banner/content.ejs", {
                    upTitle: t.components.composites.callBanner.upTitle ,
                    title: t.components.composites.callBanner.title ,
                    link: navigation(lang, 'home-one.html') ,
                    btn: t.components.composites.callBanner.btn
                }); -%> 
                <%- include("../../components/composites/project-highlights/content.ejs", {
                    title: "Project Highlights",
                    items: [
                        "Client-focused approach",
                        "Skilled and certified team",
                        "Commitment to safety and quality",
                        "Skilled and certified team"
                    ]
                }); -%>

                

                <!-- <div class="categories card-body px-4 py-4 shadow-sm rounded-2 bg-white shadow radius-all-md"> -->
                <div class="px-4 py-4 bg-on-primary-color rounded-2 radius-all-md">
                    <h4 class="font-weight-bold mb-3 on-secondary-color"><%= "Our Approach" %></h4>
                    <div class="horizontal-divider mb-3"></div>
                    <ul class="list-unstyled d-flex flex-column m-0 px-3 approach-items-list">
                        <% for (let i = 0; i < 3; i++) { %>
                            <li>
                                <%- include("../../components/composites/approach-Item/content.ejs", {
                                    number: t.components.composites.approachItem.number1 ,
                                    title: t.components.composites.approachItem.title1 ,
                                    text: t.components.composites.approachItem.description1
                                }); -%>
                            </li>
                         <% } %>
                    </ul> 
                </div>


                

               

                
            </aside>
        </div>
    </section>
    <section id="singlePageination" class="section bg-color">
        <div class="container flex-column flex-xxl-row gap-4 bg-specific-color">
            <div class="w-100 perv-project">
                <%- include("../../components/composites/next-service/content.ejs",{
                    link: navigation(lang, 'st-project'),
                    image: getMedia(lang, 'demo1/building1.png', 'images'),
                    serviceTitle: t.components.composites.nextServices.project,
                    title: t.components.composites.nextServices.title
                }); -%>
            </div>
            <div class="w-100">
                <%- include("../../components/composites/next-service/content.ejs",{
                    link: navigation(lang, 'st-project'),
                    image: getMedia(lang, 'demo1/building1.png', 'images'),
                    serviceTitle: t.components.composites.nextServices.project,
                    title: t.components.composites.nextServices.title
                }); -%>
            </div>
        </div>
    </section>
</main>

<%- include("../../layouts/page/foot.ejs"); %>